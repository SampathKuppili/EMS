# Django Secret Key and Debug Settings
SECRET_KEY=django-insecure-change-this-in-production-ems-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL or SQLite fallback)
# Set USE_POSTGRES=True to use PostgreSQL. Default is SQLite for fast local development without credentials.
USE_POSTGRES=False
DB_NAME=ems_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
